# LegalMind AI — environment template
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored; this file is committed. Never put real secrets here.

# --- LLM ---------------------------------------------------------------
# Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Embedding model used for indexing and query encoding.
# Must match whatever built the vector store, or retrieval silently degrades.
EMBEDDING_MODEL=

# --- Vector store (ChromaDB) -------------------------------------------
# In docker compose, the host is the service name: chroma
# Running the API outside compose against a containerised Chroma: localhost
CHROMA_HOST=
CHROMA_PORT=

# --- Application -------------------------------------------------------
# development | staging | production
APP_ENV=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- GCP ---------------------------------------------------------------
# Project hosting Cloud Run, GCS and Secret Manager
GCP_PROJECT_ID=
